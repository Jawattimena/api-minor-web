---
// Bron: Samen met Jad naar gekeken
// index.astro (bovenin de ---blokken)
const res = await fetch("https://api.api-ninjas.com/v2/quotes?limit=50", {
  headers: {
    "x-api-key": import.meta.env.API_KEY,
  },
});
const quotes = await res.json();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro</title>
  </head>
  <body>
    <main>
      <div id="forms">
        <form id="formName">
          <label for="name"
            >What is your name?<input
              type="text"
              name="name"
              id="name"
              placeholder="Name here"
              required
            /></label
          >
          <button>Opslaan</button>
        </form>
        <form id="formQuestions">
          <label for="vraag-1"
            >How do you feel right now in a few words?<input
              type="text"
              name="vraag-1"
              id="vraag-1"
              placeholder="Awnser here"
              required
            /></label
          >
          <fieldset>
            <legend>How would you describe your current energy level?</legend>
            <label for="Very low"
              >Very low<input
                type="radio"
                name="vraag-2"
                id="Very low"
                required
              /></label
            >
            <label for="Neutral1"
              >Neutral<input
                type="radio"
                name="vraag-2"
                id="Neutral1"
                required
              /></label
            >
            <label for="High"
              >High<input
                type="radio"
                name="vraag-2"
                id="High"
                required
              /></label
            >
          </fieldset>

          <fieldset>
            <legend
              >Which of these emotions best matches your current mood?</legend
            >
            <label for="Happy"
              >Happy<input
                type="radio"
                name="vraag-3"
                id="Happy"
                placeholder="Awnser here"
                required
              /></label
            >
            <label for="Stressed"
              >Stressed<input
                type="radio"
                name="vraag-3"
                id="Stressed"
                placeholder="Awnser here"
                required
              /></label
            >
            <label for="overwhelmed"
              >Overwhelmed<input
                type="radio"
                name="vraag-3"
                id="overwhelmed"
                placeholder="Awnser here"
                required
              /></label
            >
            <label for="hopeful"
              >Hopeful<input
                type="radio"
                name="vraag-3"
                id="hopeful"
                placeholder="Awnser here"
                required
              /></label
            >
            <label for="Motivated"
              >Motivated<input
                type="radio"
                name="vraag-3"
                id="Motivated"
                placeholder="Awnser here"
                required
              /></label
            >
            <label for="Indifferent"
              >Indifferent<input
                type="radio"
                name="vraag-3"
                id="Indifferent"
                placeholder="Awnser here"
                required
              /></label
            >
          </fieldset>

          <label for="vraag-4"
            >What do you need most right now?<input
              type="text"
              name="vraag-4"
              id="vraag-4"
              placeholder="Awnser here"
              required
            /></label
          >
          <fieldset>
            <legend
              >How do you feel about the near future (today / tomorrow)?</legend
            >
            <label for="Positive"
              >Positive<input
                type="radio"
                name="vraag-5"
                id="Positive"
                placeholder="Awnser here"
                required
              /></label
            >
            <label for="Neutral2"
              >Neutral<input
                type="radio"
                name="vraag-5"
                id="Neutral2"
                placeholder="Awnser here"
                required
              /></label
            >
            <label for="Negative"
              >Negative<input
                type="radio"
                name="vraag-5"
                id="Negative"
                placeholder="Awnser here"
                required
              /></label
            >
          </fieldset>
          <button>Opslaan</button>
        </form>
      </div>
      <div id="dailyQuote">
        <!-- In je HTML, voeg dit toe -->
        <div
          id="quotesData"
          data-quotes={JSON.stringify(quotes)}
          style="display:none"
        >
        </div>
        <p id="begroeting"></p>
        <h1 id="quoteText"></h1>
        <p id="quoteAuthor"></p>
        <button id="newDay">Simulate a new day</button>
      </div>
    </main>
    <script src="../javascript/script.js"></script>
  </body>
</html>

<style>
  @font-face {
    font-family: "Montserat";
    src: url(/fonts/Montserrat-VariableFont_wght.ttf);
  }

  @font-face {
    font-family: "Montserat Italic";
    src: url(/fonts/Montserrat-Italic-VariableFont_wght.ttf);
  }

  :root {
    --font-primary-color: rgb(0, 0, 0);
    --font-secondary-color: rgb(255, 255, 255);
    --background-color: black;
    --base-font: "Montserat";
    --italic-font: "Montserat Italic";

    --font-wght-light: 300;
    --font-wght-reg: 500;
    --font-wght-bold: 700;
  }

  *,
  ::after,
  ::before {
    box-sizing: border-box;
    font-family: var(--base-font);
    margin: 0em;
    padding: 0em;
  }

  body {
    background-color: var(--background-color);
    overflow: hidden;
    display: grid;
    place-items: center;
    height: 100vh;
  }

  #forms {
    width: 90vw;
    max-width: 50rem;
    font-family: var(--base-font);
    font-size: 1.3rem;
    font-weight: var(--font-wght-reg);

    #formName {
      color: var(--font-primary-color);
      flex-direction: column;
      background-color: white;
      padding: 2rem;
      width: 90vw;
      max-width: 30em;
      border-radius: 1em;

      button {
        align-self: end;
      }
    }

    #formQuestions {
      font-family: var(--base-font);
      color: var(--font-primary-color);
      display: flex;
      flex-direction: column;
      gap: 3rem;
      overflow-y: scroll;
      height: 70vh;
      background-color: white;
      padding: 2em;
      border-radius: 1em;
    }
  }

  #dailyQuote {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    color: var(--font-secondary-color);

    h1 {
      font-size: 3rem;
      font-weight: var(--font-wght-reg);
      line-height: 4rem;
      margin: 0.5em 0 0 0;
      text-align: center;

      width: 80vw;
      max-width: 30em;
    }

    p {
      font-size: 1.5rem;
      font-weight: var(--font-wght-light);

      &:nth-of-type(2) {
        font-size: 1rem;
        font-family: var(--italic-font);
        font-weight: var(--font-wght-light);
        margin: 0 0 2rem 0;
      }
    }
  }

  /* Components ---------------------------------------- */

  /* Buttons */
  button {
    font-weight: var(--font-wght-reg);
    padding: 1rem 2rem;
    appearance: none;
    border: red 1px solid;
    border-radius: 2rem;
    cursor: pointer;
    background-color: red;
    color: white;
    width: fit-content;

    &:hover {
      background-color: red;
      color: black;
    }

    &:active {
      background-color: darkred;
      color: black;
    }
  }

  #newDay {
    display: none;
  }

  /* Text inputs */
  label {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  input[type="text"] {
    appearance: none;
    border: gray 1px solid;
    margin: 1rem 0rem;
    padding: 1em;
    border-radius: 1em;
    font-size: 0.9em;
  }

  /* Radio inputs */
  fieldset:has(input[type="radio"]) {
    border: none;
    display: grid;
    flex-direction: column;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(10em, 1fr));

    legend {
      margin: 0 0 1rem 0;
    }

    label {
      padding: 1.5rem 1rem;
      width: 100%;
      font-size: 0.9rem;
      border: red 1px solid;
      background-color: white;
      color: black;
      height: 2em;
      border-radius: 1em;
      display: flex;
      justify-content: center;
      align-items: center;
      cursor: pointer;

      &:has(input:checked) {
        background-color: red;
        color: white;
      }

      input {
        appearance: none;
      }
    }
  }
</style>
